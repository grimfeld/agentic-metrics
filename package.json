{
  "name": "agentic-metrics",
  "version": "0.3.0",
  "description": "Measure an agentic engineering workflow from GitHub and Claude Code transcripts.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agentic-metrics": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
