{
  "description": "agentic-metrics hooks",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-end.ts"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pr-link-warning.ts"]
          }
        ]
      }
    ]
  }
}
